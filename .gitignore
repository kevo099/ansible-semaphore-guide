# Keep local inventories, secrets, reports and runtime state out of Git.
.venv/
__pycache__/
*.py[cod]
.cache/
.ansible/
collections/
inventories/*
!inventories/lab.ini.example
group_vars/
host_vars/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.pub
known_hosts*
*password*
*secret*
config.json
reports/
backups/
*.dump
*.sql
*.tar
*.tar.gz
*.zip
*.log
*.retry
.DS_Store
